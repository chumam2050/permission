{
    "name": "choerulumam/permission",
    "description": "Permission module for Choerulumam",
    "keywords": [
        "laravel",
        "permission",
        "role",
        "choerulumam"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "choerulumam",
            "email": "choerulumam2050@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Choerulumam\\Permission\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Choerulumam\\Permission\\Tests\\": "tests/",
            "App\\": "vendor/orchestra/testbench-core/laravel/app/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^12.5"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Choerulumam\\Permission\\PermissionServiceProvider"
            ]
        }
    }
}